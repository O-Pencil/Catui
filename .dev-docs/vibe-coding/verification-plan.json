{
  "schemaVersion": 1,
  "repository": "O-Catui/Catui",
  "description": "Authoritative full-verification membership for the CATUI/nanoPencil repository. Every entry maps to a canonical npm script; test/verification-contract.test.ts fails if this file and package.json drift apart.",
  "artifactRoot": ".catui/dev-loop",
  "commands": [
    {
      "id": "dev-loop-tests",
      "label": "Dev-loop focused tests",
      "command": "npm run test:dev-loop",
      "required": true,
      "category": "test",
      "timeoutMs": 120000
    },
    {
      "id": "dip",
      "label": "DIP documentation map",
      "command": "npm run verify:dip",
      "required": true,
      "category": "dip",
      "timeoutMs": 120000
    },
    {
      "id": "quality",
      "label": "Architecture quality boundaries",
      "command": "npm run verify:quality",
      "required": true,
      "category": "quality",
      "timeoutMs": 120000
    },
    {
      "id": "package-boundary",
      "label": "Package boundary (static)",
      "command": "npm run verify:package-boundary",
      "required": true,
      "category": "package-boundary",
      "timeoutMs": 120000
    },
    {
      "id": "build",
      "label": "Build project",
      "command": "npm run build",
      "required": true,
      "category": "build",
      "timeoutMs": 600000
    },
    {
      "id": "typecheck",
      "label": "TypeScript type check",
      "command": "npm run typecheck",
      "required": true,
      "category": "typecheck",
      "timeoutMs": 300000
    },
    {
      "id": "package-boundary-dist",
      "label": "Package boundary (dist embed resolves)",
      "command": "npm run verify:package-boundary:dist",
      "required": true,
      "category": "package-boundary",
      "timeoutMs": 120000
    },
    {
      "id": "verification-contract",
      "label": "Plan/script drift guard",
      "command": "npm run verify:contract",
      "required": true,
      "category": "test",
      "timeoutMs": 120000
    },
    {
      "id": "release-contract-tests",
      "label": "Release packaging contract tests (build-free)",
      "command": "npm run test:release-contracts",
      "required": true,
      "category": "test",
      "timeoutMs": 180000
    },
    {
      "id": "artifact-tests",
      "label": "Post-build artifact tests (require dist)",
      "command": "npm run test:artifact",
      "required": true,
      "category": "test",
      "timeoutMs": 180000
    },
    {
      "id": "security-tests",
      "label": "Security boundary tests",
      "command": "npm run test:security",
      "required": true,
      "category": "test",
      "timeoutMs": 120000
    },
    {
      "id": "command-tests",
      "label": "Slash command catalog tests",
      "command": "npm run test:commands",
      "required": true,
      "category": "test",
      "timeoutMs": 120000
    },
    {
      "id": "tool-tests",
      "label": "Tool boundary tests",
      "command": "npm run test:tools",
      "required": true,
      "category": "test",
      "timeoutMs": 120000
    },
    {
      "id": "runtime-owner-tests",
      "label": "Runtime owner, registry and bootstrap tests",
      "command": "npm run test:runtime-owners",
      "required": true,
      "category": "test",
      "timeoutMs": 180000
    },
    {
      "id": "mcp-tests",
      "label": "MCP and system prompt tests",
      "command": "npm run test:mcp",
      "required": true,
      "category": "test",
      "timeoutMs": 120000
    },
    {
      "id": "session-tests",
      "label": "Session management tests",
      "command": "npm run test:sessions",
      "required": true,
      "category": "test",
      "timeoutMs": 180000
    },
    {
      "id": "presence-tests",
      "label": "Presence lifecycle tests",
      "command": "npm run test:presence",
      "required": true,
      "category": "test",
      "timeoutMs": 180000
    },
    {
      "id": "harness-critical",
      "label": "Critical harness state and eval gate",
      "command": "npm run test:harness-critical",
      "required": true,
      "category": "test",
      "timeoutMs": 600000
    }
  ],
  "prChecks": {
    "provider": "gh",
    "command": "gh pr checks <number> --json name,state,link,workflow,bucket,description,startedAt,completedAt",
    "watchCommand": "gh pr checks <number> --watch --json name,state,link,workflow,bucket,description,startedAt,completedAt"
  }
}
